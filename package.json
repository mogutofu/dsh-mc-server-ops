{
  "name": "dsh-mc-server-ops",
  "version": "0.6.0",
  "description": "在 DeepSeek Harness 里托管 Minecraft 服务器的插件：状态/启停/日志/白名单/投票授权，静态命令拦截，本地/Pterodactyl 可插拔适配器，游戏聊天直通 QQ 群（不经过 AI、不耗 token），把人设注入 QQ 会话，并让游戏内玩家用 /ai 和「小铜」对话（配套 Forge mod）。需要先安装 QQ 机器人插件。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "ops/*.ps1",
    "ops/*.mjs",
    "ops/adapters/*.mjs",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run check",
    "check": "node --check index.js && node --check client.js && node --check ops/coalesce.mjs && node --check ops/rcon.mjs && node --check ops/command-guard.mjs && node --check ops/adapters/index.mjs && node --check ops/adapters/local.mjs && node --check ops/adapters/pterodactyl.mjs && node --check ops/qq-bridge.mjs && node --check ops/rcon-probe.mjs",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "minecraft",
    "minecraft-server",
    "minecraft-server-manager",
    "server",
    "server-management",
    "game-server",
    "rcon",
    "pterodactyl",
    "qqbot",
    "qq-group",
    "kubejs",
    "cordis"
  ],
  "license": "MIT",
  "author": "mogutofu (https://github.com/mogutofu)",
  "engines": {
    "node": ">=20.3.0",
    "dsh": ">=0.2.0-0"
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.1",
    "@tencent-connect/dsh-qqbot": ">=0.5.0"
  },
  "peerDependenciesMeta": {
    "@tencent-connect/dsh-qqbot": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mogutofu/dsh-mc-server-ops.git"
  },
  "homepage": "https://github.com/mogutofu/dsh-mc-server-ops#readme",
  "bugs": {
    "url": "https://github.com/mogutofu/dsh-mc-server-ops/issues"
  }
}
